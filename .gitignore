# ─────────────────────────────────────────────────────────────
# AntivirusAI V7 — .gitignore  (code-only repository)
# Datasets, venv, secrets, and large binaries stay LOCAL only.
# Rebuild them with: setup_environment.py  +  build_hash_db.py
# ─────────────────────────────────────────────────────────────

# ---- Secrets (NEVER commit) ----
keys.csv
*.key
*.pem
config/gemini_key.txt

# ---- Local reorg / archive ----
OLD/


# ---- Python caches ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# ---- Editor / tooling ----
.claude/
.vscode/
.idea/

# ---- Large data & runtime artifacts (regenerated locally) ----
data/
HASH/
quarantine/
logs/
evaluation/
reports/

# ---- Virtual environments (rebuild with install_environment.ps1) ----
venv_v7/
friend_venv/
vmenv/

# ---- Loose large-data patterns (defense in depth) ----
*.dat
*.npy
*.jsonl
*.pth


